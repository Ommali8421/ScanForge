# ScanForge Environment Configuration Template
# Copy to .env and adjust values as needed.

# Compose Profile: 'mock' (lightweight) or 'gpu' (NVIDIA CUDA pipeline)
COMPOSE_PROFILES=mock

# Engine Mode: 'mock' (simulated processing with procedural output) or 'real' (COLMAP, OpenMVS, etc.)
SCANFORGE_ENGINE=mock

# Database and Cache
SCANFORGE_DB_URL=sqlite:////data/scanforge.db
SCANFORGE_REDIS_URL=redis://redis:6379/0

# Storage and Directories
SCANFORGE_DATA_DIR=/data
FRONTEND_ORIGIN=http://localhost:3000

# RQ Queue Names (Separate queues for mock and gpu profiles)
SCANFORGE_QUEUE_MOCK=scanforge_mock
SCANFORGE_QUEUE_GPU=scanforge_gpu

# Upload and Processing Limits
SCANFORGE_MAX_UPLOAD_MB=2048
SCANFORGE_MAX_VIDEO_SECONDS=180
SCANFORGE_MAX_FRAMES_PHOTO=300
SCANFORGE_MAX_FRAMES_3DGS=300

# Concurrency & Timeouts
SCANFORGE_CONCURRENCY=1
SCANFORGE_STAGE_TIMEOUT=7200
SCANFORGE_JOB_TIMEOUT=21600
SCANFORGE_JOB_TTL_DAYS=30

# Feature Flags
ENABLE_LIDAR=false

# GPU and CUDA Tuning (RTX 4060: 8GB VRAM, Compute 8.9)
TORCH_CUDA_ARCH_LIST=8.9
CUDA_ARCHITECTURES=89
